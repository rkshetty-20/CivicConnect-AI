# FastAPI AI microservice server binding
PORT=8000
HOST=0.0.0.0

# Minimum confidence threshold used by the fake-report / classification heuristics
CONFIDENCE_THRESHOLD=0.6

# Optional path to custom YOLO weights for image classification.
# If the file is absent, the service uses its built-in lightweight image heuristics.
MODEL_WEIGHTS_PATH=./app/weights/yolov8_civic.pt

# Optional: OpenRouter API key for LLM-powered complaint classification and
# intelligence generation (priority score, summary, recommended department,
# suggested action, safety risk). If left EMPTY, the service automatically falls
# back to a deterministic offline keyword engine that returns the same payload
# shape, so the app stays fully functional without any external credentials.
OPENROUTER_API_KEY=
