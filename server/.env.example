PORT=5001
MONGO_URI=mongodb://localhost:27017/civicconnect
JWT_SECRET=change_this_to_a_long_random_secret
SERVER_URL=http://localhost:5001
AI_SERVICE_URL=http://localhost:8000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Optional: OpenRouter key used by the FastAPI AI microservice for LLM classification.
# If left empty, the AI service falls back to an offline keyword-based classifier.
OPENROUTER_API_KEY=

# Optional: Cloudinary credentials for image uploads.
# If left blank (or set to your_* placeholders), images are saved to server/uploads and served locally.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
