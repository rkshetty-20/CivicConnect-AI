# Backend API base URL
VITE_API_URL=http://localhost:5001/api

# Optional: Google Geocoding API key for address lookups (reverse geocode / place search).
# The visible map always uses free Leaflet/OpenStreetMap tiles — this key is NOT for map tiles.
# IMPORTANT: any key in a browser bundle is publicly visible, so restrict it by HTTP referrer
# (and enable only the Geocoding API) in Google Cloud Console. Leave blank to use the
# keyless OpenStreetMap/Nominatim fallback via /api/geo.
VITE_GOOGLE_MAPS_API_KEY=
